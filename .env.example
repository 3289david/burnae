# ── 데이터베이스 ─────────────────────────────────────────────
DATABASE_URL="postgresql://burnae:비밀번호@localhost:5432/burnae?schema=public"

# ── 인증 ─────────────────────────────────────────────────────
# 세션 JWT 서명 키. 아래 명령으로 생성: openssl rand -base64 32
AUTH_SECRET=""

# ── Pterodactyl ──────────────────────────────────────────────
# 패널 주소 (끝에 슬래시 없이)
PTERODACTYL_URL="https://panel.burnae.kr"
# Application API 키 — 패널 관리자 계정 > API Credentials > Application API (ptla_로 시작)
PTERODACTYL_APPLICATION_API_KEY=""
# Client API 키 — 반드시 "모든 서버 접근" 권한이 있는 관리자 계정에서 발급 (ptlc_로 시작)
# 패널 Settings > Advanced 에서 관리자의 전체 서버 접근을 허용해야 함
PTERODACTYL_CLIENT_API_KEY=""

# ── Cloudflare (서브도메인 자동 생성) ─────────────────────────
# krl.kr 존을 관리하는 API 토큰 (Zone:DNS:Edit 권한만 있으면 됨)
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_SUBDOMAIN_ZONE="krl.kr"

# ── PaySync (paysync.kr, 무통장입금 자동확인) ──────────────────
# 대시보드 > API 관리에서 발급
PAYSYNC_API_KEY=""
# 대시보드 > 웹훅 관리에서 발급되는 서명 시크릿 (whsec_로 시작)
# 웹훅 엔드포인트 URL: https://burnae.kr/api/webhooks/paysync
PAYSYNC_WEBHOOK_SECRET=""

# ── Anthropic (AI 서버 관리 챗봇) ───────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ── 디스코드 봇 ─────────────────────────────────────────────
DISCORD_BOT_TOKEN=""
DISCORD_CLIENT_ID=""
# 개발 중 특정 서버에만 즉시 명령어를 반영하고 싶을 때만 설정 (운영에서는 비워두면 전역 등록)
DISCORD_GUILD_ID=""
SUBDOMAIN_ZONE="krl.kr"
# OAuth2 URL Generator에서 만든 봇 초대 링크 — 고객 대시보드에 "봇 초대하기" 버튼으로 노출됨
NEXT_PUBLIC_DISCORD_INVITE_URL=""

# ── 사이트 ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://burnae.kr"
NODE_ENV="production"
