# ── 데이터베이스 ─────────────────────────────────────────────
DATABASE_URL="postgresql://burnae:비밀번호@localhost:5432/burnae?schema=public"

# ── 인증 ─────────────────────────────────────────────────────
# 세션 JWT 서명 키. 아래 명령으로 생성: openssl rand -base64 32
AUTH_SECRET=""
# 관리자 패널(/admin)에 들어갈 수 있는 유일한 이메일. 이 이메일로 가입/로그인하면
# 자동으로 관리자가 되고, 그 외 계정은 role을 DB에서 직접 바꿔도 절대 admin 화면에 못 들어감
ADMIN_EMAIL="davideom0414@gmail.com"

# ── Pterodactyl ──────────────────────────────────────────────
# 패널 주소 (끝에 슬래시 없이)
PTERODACTYL_URL="https://panel.burnae.kr"
# Application API 키 — 패널 관리자 계정 > API Credentials > Application API (ptla_로 시작)
PTERODACTYL_APPLICATION_API_KEY=""
# Client API 키 — 반드시 "모든 서버 접근" 권한이 있는 관리자 계정에서 발급 (ptlc_로 시작)
# 패널 Settings > Advanced 에서 관리자의 전체 서버 접근을 허용해야 함
PTERODACTYL_CLIENT_API_KEY=""

# ── Cloudflare (서브도메인 자동 생성) ─────────────────────────
# krl.kr 존을 관리하는 API 토큰 (Zone:DNS:Edit 권한만 있으면 됨)
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_SUBDOMAIN_ZONE="krl.kr"

# ── 하나은행 Open API (apiportal.hanabank.com, 무통장입금 자동확인) ─
# 하나은행 오픈API 포털에서 서비스 등록 후 발급되는 앱키. client_credentials 방식이라
# 별도 사용자 동의(OAuth) 절차 없이 바로 토큰 발급 가능 (유효기간 1년).
HANABANK_CLIENT_ID=""
HANABANK_CLIENT_SECRET=""
# 결제를 받을 계좌 — 반드시 하나은행 + 사업자번호가 연결된 계좌(개인사업자/법인)여야 함
# (거래내역조회 API가 순수 개인계좌는 지원하지 않음)
HANABANK_ACCOUNT_NUMBER=""
HANABANK_BUSINESS_REG_NO=""
# "dev" | "test" | 비워두면 운영계(api.hanabank.com) 사용
HANABANK_ENV=""

# ── OpenRouter (AI 서버 관리 챗봇 — 저렴한 오픈소스 모델) ─────────
# https://openrouter.ai/keys 에서 발급
OPENROUTER_API_KEY=""
# 기본값: Qwen3 235B A22B Instruct (Apache-2.0 오픈소스, tool-calling 지원, 저렴함)
# 더 저렴하게 쓰려면 "qwen/qwen3-30b-a3b-instruct-2507" 로 바꿔도 됨
OPENROUTER_MODEL="qwen/qwen3-235b-a22b-2507"

# ── 소셜 로그인 (Google / GitHub / Discord) ──────────────────────
# Google Cloud Console → OAuth 동의 화면 + 사용자 인증 정보
# 리디렉션 URI: https://burnae.kr/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub → Settings → Developer settings → OAuth Apps
# 콜백 URL: https://burnae.kr/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# 디스코드 로그인은 봇과 같은 Application을 재사용 (DISCORD_CLIENT_ID 공용).
# OAuth2 탭에서 Client Secret 발급, Redirect 등록: https://burnae.kr/api/auth/oauth/discord/callback
DISCORD_CLIENT_SECRET=""

# ── 디스코드 봇 (Burnae 공식 서버 전용 — 고객이 자기 서버에 추가하는 게 아님) ──
DISCORD_BOT_TOKEN=""
DISCORD_CLIENT_ID=""
# 필수. Burnae 공식 디스코드 서버의 길드 ID. 이 서버가 아니면 봇이 응답하지 않음
DISCORD_GUILD_ID=""
# 선택. /link 성공 시 자동으로 부여할 "고객" 역할 ID
DISCORD_CUSTOMER_ROLE_ID=""
# 선택. /문의 로 만들어진 비공개 채널에서 멘션할 운영진 역할 ID
DISCORD_SUPPORT_ROLE_ID=""
SUBDOMAIN_ZONE="krl.kr"
# 공식 서버 초대 링크 — 대시보드에 "공식 디스코드 참여하기" 링크로 노출됨 (discord.gg/...)
NEXT_PUBLIC_DISCORD_SERVER_INVITE_URL=""

# ── 사이트 ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://burnae.kr"
NODE_ENV="production"
