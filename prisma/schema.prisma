// Burnae Hosting — 데이터 모델
// 학습 참고: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────
// 계정
// ────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

/// 관리자 세부 역할 — 관리자(role=ADMIN)에게만 의미가 있다. 소유자 이메일(getAdminEmail)은
/// 이 값과 무관하게 항상 전체 접근 권한을 가진다(SUPER와 동일하게 취급)
enum AdminRole {
  COMMUNITY
  PROMOTION
  GENERAL
  SUPER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                     String     @id @default(cuid())
  email                  String     @unique
  name                   String
  role                   UserRole   @default(USER)
  /// role이 ADMIN일 때만 의미 있음 — 어느 관리자 영역에 접근할 수 있는지
  adminRole              AdminRole?
  status                 UserStatus @default(ACTIVE)
  /// 인당 총 저장공간 한도(GB). null이면 HostingSettings.defaultUserStorageGb 적용
  storageQuotaGbOverride Int?
  aiCreditsRemaining     Int        @default(0)
  /// 결제 안내에 쓸 입금자명 직접 설정(1~5자, 공백 불가). null이면 이름 기반 자동 생성
  preferredDepositorName String?
  /// 서버 홍보 활동으로 모은 포인트 — 무료 서버 교환 등에 사용
  promotionPoints        Int        @default(0)
  /// 가입(최초 계정 생성) 시점의 IP — 무료 서버 1인 1개 제한을 부계정으로 우회하는지 탐지하는 데 사용.
  /// 가입 전부터 있던 계정은 null(소급 적용 안 함)
  signupIp               String?
  /// OCTOMO(문자 발신 인증)로 확인된 휴대폰 번호 — 계정 하나당 번호 하나만 허용(unique)해서
  /// 같은 번호로 여러 계정을 인증해 무료 서버 제한을 우회하는 걸 막는다. 무료 서버 생성 전 필수.
  verifiedPhoneNumber    String?    @unique
  phoneVerifiedAt        DateTime?
  /// Pterodactyl 패널 계정의 내부 유저 ID. 첫 서버 생성 시 채워짐 — SFTP 비밀번호 재발급 등에 사용
  pterodactylUserId      Int?       @unique
  /// SFTP 접속용으로 재발급한 패널 계정 비밀번호(평문) — 소유자에게만 노출. accessSecret과 동일한 이유로 평문 저장
  sftpPassword           String?
  /// 이메일/비밀번호 로그인용 비밀번호 해시(scrypt). 소셜 로그인만 쓰는 계정은 null
  passwordHash           String?
  /// 이메일/비밀번호로 가입한 계정이 인증 메일의 링크를 클릭한 시점. 소셜 로그인 계정은 그 자체로
  /// 인증된 것으로 간주해 가입 시점에 바로 채워짐. null이면 로그인이 막힌다(가입 시 1회만 인증)
  emailVerifiedAt        DateTime?
  twoFactorEnabled       Boolean    @default(false)
  /// TOTP 비밀키(base32). 평문 저장 — sftpPassword와 같은 이유(복구 불가능한 해시로는 재사용 불가)
  twoFactorSecret        String?
  /// 2FA 기기를 잃어버렸을 때 쓰는 1회용 복구 코드 — scrypt로 해시해서 저장, 쓸 때마다 하나씩 제거
  twoFactorBackupCodes   String[]   @default([])
  /// 친구 추천용 코드. 가입 링크에 ?ref=코드 로 붙여서 공유
  referralCode            String     @unique @default(cuid())
  referredByUserId        String?
  referredBy              User?      @relation("Referrals", fields: [referredByUserId], references: [id])
  referredUsers           User[]     @relation("Referrals")
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  servers              Server[]
  orders               Order[]
  aiConversations      AiConversation[]
  aiActivityLogs       AiActivityLog[]
  discordLink          DiscordLink?
  auditLogs            AuditLog[]
  teamMemberships      ServerMember[]
  couponRedemptions    CouponRedemption[]
  oauthAccounts        OAuthAccount[]
  promotionCompletions PromotionCompletion[]
  surveyResponses      SurveyResponse[]
  shopRedemptions      ShopRedemption[]
  extraFreeSlotGrants  ExtraFreeSlotGrant[]
  userPresets          UserPreset[]
  resourceUpgradeGrants ResourceUpgradeGrant[]
  serverActivityLogs   ServerActivityLog[]
  phoneVerificationRequest PhoneVerificationRequest?
  emailVerificationToken EmailVerificationToken?
  dedicatedNode            HostNode?              @relation("DedicatedNode")
  supportThreads           SupportThread[]
  apiTokens                ApiToken[]
  blogPosts                BlogPost[]
  githubConnection         GitHubConnection?

  @@index([email])
  @@index([referralCode])
  @@index([signupIp])
}

/// OCTOMO 문자 인증 진행 중인 요청 1건(유저당 최대 1개 — 새로 시작하면 덮어씀).
/// "code" 문자를 1666-3538로 보내달라고 안내한 뒤, 확인 시점에 OCTOMO API로 수신 여부를 조회한다.
model PhoneVerificationRequest {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String
  code        String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
}

/// 이메일/비밀번호 가입 시 보내는 인증 메일의 토큰 1건(유저당 최대 1개 — 재발송하면 덮어씀)
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  DISCORD
}

/// 소셜 로그인 연결 정보. 한 유저가 여러 프로바이더로 로그인할 수 있음(이메일 기준 자동 연결)
model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ────────────────────────────────
// 호스팅 인프라 (Pterodactyl 미러링)
// ────────────────────────────────

enum NodeStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

model HostNode {
  id                String     @id @default(cuid())
  name              String
  location          String
  pterodactylNodeId Int        @unique
  fqdn              String
  /// 고객에게 SFTP 접속 주소로 보여줄 호스트명. 비워두면 fqdn을 그대로 쓴다.
  /// fqdn은 Wings 데몬 자체(패널↔Wings 통신)용이라, 고객에게 보여줄 이름을 따로 관리할 수 있게 분리
  sftpFqdn          String?
  publicIp          String
  totalRamMb        Int
  totalDiskMb       Int
  reservedRamMb     Int        @default(0)
  reservedDiskMb    Int        @default(0)
  cpuCores          Int
  /// Wings SFTP 리슨 포트. config.yml의 sftp.bind_port와 항상 일치해야 한다(기본 2022)
  sftpPort          Int        @default(2022)
  status            NodeStatus @default(ONLINE)
  autoDeployEnabled Boolean    @default(true)
  /// 이 노드를 유저 한 명에게 통째로 전용 배정했으면 채워진다. 채워진 노드는 일반 배치
  /// 풀에서 제외되고, 오직 이 유저의 "전용서버"류 상품 주문만 여기로 배치된다
  dedicatedToUserId String?    @unique
  dedicatedToUser   User?      @relation("DedicatedNode", fields: [dedicatedToUserId], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  servers Server[]

  @@index([status])
}

/// Pterodactyl Egg(서버 종류) 미러링 — Paper/Fabric/Forge/NeoForge/Vanilla 등
/// 서버 종류의 큰 분류. 마인크래프트 외 서비스(디스코드봇/VPS/기타)로 확장하기 위함 —
/// 실제로는 전부 Pterodactyl 컨테이너(egg)로 구현되고, VPS류(code-server 등)는 별도 카테고리 없이
/// GENERAL("일반 서버")에 포함된다
enum ServerCategory {
  MINECRAFT
  DISCORD_BOT
  GENERAL
}

model ServerTemplate {
  id                 String         @id @default(cuid())
  key                String         @unique // "paper", "fabric", "forge", "neoforge", "vanilla", "purpur", "vps-ubuntu", ...
  displayName        String
  category           ServerCategory @default(MINECRAFT)
  pterodactylNestId  Int
  pterodactylEggId   Int
  dockerImage        String
  startupCommand     String
  minecraftVersions  String[] // 선택 가능한 마인크래프트 버전 목록 (MINECRAFT 카테고리에서만 사용)
  /// 런타임 버전 선택지가 여러 개인 egg(Node.js/Python/Java/C#/Rust 등)용. {"라벨": "도커이미지"} — null이면 dockerImage 하나뿐
  availableDockerImages Json?
  defaultEnvironment Json // Pterodactyl egg 기본 environment 변수
  /// egg import 시 Pterodactyl에서 받아온 변수 메타데이터 — [{envVariable, name, description, rules}].
  /// rules에 "required"가 있고 defaultEnvironment 값이 빈 문자열이면 주문 시 사용자가 직접 입력해야
  /// 서버 생성이 가능하다(디스코드 봇 토큰, API 키 등). import-egg 이전에 만든 템플릿은 null일 수 있음.
  variableSchema     Json?
  active             Boolean        @default(true)
  sortOrder          Int            @default(0)

  servers      Server[]
  products     Product[]
  userPresets  UserPreset[]

  @@index([active])
  @@index([category])
}

/// 유저가 일반 런타임(Node.js/Python 등 생성형 종류 — 특정 음악봇처럼 미리 다 만들어진 종류는
/// 해당 없음) 위에 자기 깃허브 저장소를 올려서 공개한 "커뮤니티 프리셋". 환경변수(봇 토큰 등)는
/// 프리셋에 담지 않는다 — 이 프리셋으로 서버를 만드는 사람이 직접 입력한다. 즉시 공개되고,
/// 다른 유저의 신고가 일정 수 쌓이면 자동으로 목록에서 내려간다.
model UserPreset {
  id             String   @id @default(cuid())
  baseTemplateId String
  baseTemplate   ServerTemplate @relation(fields: [baseTemplateId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  displayName    String
  blurb          String?
  /// 서버 생성 시 GIT_ADDRESS로 그대로 적용되는 깃 저장소 주소
  gitRepoUrl     String
  reportCount    Int      @default(0)
  /// 이 프리셋으로 실제 서버가 만들어진 횟수 — 인기순 정렬 + 설치 1회당 포인트 지급에 사용
  useCount       Int      @default(0)
  /// 신고 누적으로 자동 비공개된 프리셋. 관리자가 /admin/logs 등에서 확인 가능
  delisted       Boolean  @default(false)
  createdAt      DateTime @default(now())

  reports UserPresetReport[]

  @@index([baseTemplateId])
  @@index([createdById])
  @@index([delisted])
}

model UserPresetReport {
  id         String     @id @default(cuid())
  presetId   String
  preset     UserPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  reporterId String
  reason     String?
  createdAt  DateTime   @default(now())

  @@unique([presetId, reporterId])
  @@index([presetId])
}

// ────────────────────────────────
// 상품/가격 (관리자 설정)
// ────────────────────────────────

/// 사이트 전체가 어떤 서비스를 노출할지 — 관리자 설정에서 토글
enum SiteMode {
  MINECRAFT_ONLY
  GENERAL_ONLY
  BOTH
}

model HostingSettings {
  id                     Int      @id @default(1)
  siteMode               SiteMode @default(MINECRAFT_ONLY)
  ramPricePerGbKrw       Int      @default(5000)
  minRamGb               Int      @default(1)
  maxRamGb               Int      @default(32)
  defaultDiskGb          Int      @default(20)
  diskPricePerGbKrw      Int      @default(100)
  defaultBackupSlots     Int      @default(3)
  backupPricePerSlotKrw  Int      @default(500)
  /// 유저 1인당 기본 저장공간 한도(GB). 관리자가 상향 가능, 유저별 override는 User.storageQuotaGbOverride
  defaultUserStorageGb   Int      @default(10)
  maxCpuPercentPerServer Int      @default(800)
  siteName               String   @default("Burnae")
  siteDomain             String   @default("burnae.kr")
  subdomainZone          String   @default("krl.kr")
  /// true면 노드 자리가 나는 대로 크론이 선주문을 자동 배치. false면 관리자가 /admin/preorders에서
  /// 직접 "지금 배치하기"를 눌러야만 처리됨
  preorderAutoFulfillEnabled Boolean @default(true)
  /// true면 노드 자리 여유와 상관없이 모든 신규 주문을 무조건 "선주문"으로 처리
  forcePreorderEnabled   Boolean  @default(false)
  updatedAt              DateTime @updatedAt

  @@map("hosting_settings")
}

model Product {
  id                String   @id @default(cuid())
  name              String
  description       String?
  /// 영어(/en) 페이지에 보여줄 이름 — 비어 있으면 name을 그대로 보여준다
  nameEn            String?
  descriptionEn     String?
  ramMb             Int
  cpuPercent        Int
  diskMb            Int
  backupSlots       Int      @default(3)
  aiCreditsPerMonth Int      @default(0)
  priceMonthlyKrw   Int
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  /// 홍보 포인트로 교환 가능한 상품인지 (예: 무료 체험 서버)
  pointsRedeemable  Boolean  @default(false)
  /// pointsRedeemable이 true일 때 필요한 포인트
  pointsCost        Int?
  /// 주문 시점에 자리가 없어 "선주문"이 되는 경우 적용할 가격. null이면 priceMonthlyKrw 그대로 사용
  preorderPriceKrw  Int?
  /// true면 일반 배치 풀이 아니라 그 유저에게 전용 배정된 노드(HostNode.dedicatedToUserId)에만
  /// 배치한다. 아직 전용 노드가 없으면 선주문으로 대기하고 관리자에게 배정을 요청하는 알림이 간다
  requiresDedicatedNode Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  allowedTemplates ServerTemplate[]
  orders           Order[]
  servers          Server[]

  @@index([active])
}

// ────────────────────────────────
// 주문/결제 (하나은행 Open API 무통장입금 자동확인)
// ────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum OrderType {
  NEW_SERVER
  RENEWAL
  UPGRADE
  /// 플랜에 딸려오는 게 아니라 AI 크레딧만 단독으로 결제해서 충전
  AI_CREDITS
  /// 홍보 포인트를 돈으로 직접 충전 (1원 = 1포인트)
  POINTS
}

model Order {
  id                        String      @id @default(cuid())
  userId                    String
  user                      User        @relation(fields: [userId], references: [id])
  /// 상품이 삭제되면 null이 된다 — 그래도 과거 주문 기록은 productNameSnapshot으로 남는다
  productId                 String?
  product                   Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// 주문 시점 상품명 스냅샷. 상품이 나중에 삭제/변경돼도 결제내역에서 어떤 상품이었는지 알 수 있게 남겨둔다
  productNameSnapshot       String?
  type                      OrderType   @default(NEW_SERVER)
  serverId                  String?
  server                    Server?     @relation(fields: [serverId], references: [id])
  status                    OrderStatus @default(PENDING)
  amountKrw                 Int
  /// 결제 자동 매칭용 입금자명 (1~5자, 공백 불가). 포인트로 교환한 무료 주문은 사용 안 함.
  /// 코인 결제 주문은 "CRYPTO-xxxx"(유효한 입금자명 형식보다 길어서 실제 계좌이체 매칭과 절대
  /// 안 겹침)로 채워서 NOT NULL 제약은 지키되 은행 입금 매칭 로직에는 영향이 없게 한다
  depositorName             String
  cryptoPayment             CryptoPayment?
  couponId                  String?
  coupon                    Coupon?     @relation(fields: [couponId], references: [id])
  discountKrw               Int         @default(0)
  paidAt                    DateTime?
  expiresAt                 DateTime?
  serverNameRequested       String?
  templateIdRequested       String?
  minecraftVersionRequested String?
  /// GIT_ADDRESS를 지원하는 서버 종류에서 이 깃 저장소를 clone해서 시작(비워두면 빈 서버)
  gitRepoRequested          String?
  /// 런타임 버전 선택지가 있는 서버 종류에서 고른 도커 이미지(예: Python 3.11). 비워두면 템플릿 기본값
  dockerImageRequested      String?
  /// 서버 생성 시 적용할 커뮤니티 프리셋(UserPreset). 골라둔 환경변수 값을 defaultEnvironment 위에 덮어쓴다
  presetIdRequested         String?
  /// 템플릿의 variableSchema 중 "필수인데 기본값이 빈 문자열"인 항목을 주문 시점에 사용자가 직접
  /// 입력한 값 — {ENV_VAR: "값"}. 디스코드 봇 토큰, API 키처럼 서버마다 달라야 하는 값이라
  /// defaultEnvironment로는 채울 수 없는 것들
  customVariables           Json?
  /// type이 AI_CREDITS일 때 이 주문으로 충전되는 크레딧 수
  aiCreditsAmount           Int?
  /// type이 POINTS일 때 이 주문으로 충전되는 포인트 수 (1원 = 1포인트, amountKrw와 항상 같음)
  pointsAmount              Int?
  /// 관리자가 결제/포인트 차감 없이 지급한 주문인지 — true여야만 대시보드에서 "지급된 서버"로
  /// 안내하고 안전하게 취소할 수 있다. false(=유저가 실제로 결제한 주문)인데 서버 종류를 아직
  /// 안 고른 상태는 "지급"이 아니라 그냥 미완료 결제라서, 같은 배너로 잘못 안내하거나 실수로
  /// 취소했다가 결제한 돈을 날리는 일이 없도록 이 필드로 명확히 구분한다
  isAdminGrant              Boolean     @default(false)
  /// 결제(또는 포인트 교환)는 끝났지만 노드 여유 공간이 없어서 서버 생성을 대기 중인 "선주문" 상태
  preorderWaiting           Boolean     @default(false)
  /// 주문 시점부터 이미 "선주문"으로 안내되고 진행된 주문인지 (preorderPriceKrw 적용 여부 판단용).
  /// preorderWaiting은 이후 자리가 나면 false로 풀리지만, isPreorder는 기록으로 계속 남는다
  isPreorder                Boolean     @default(false)
  /// 전용 노드가 아직 배정되지 않아 선주문 대기 중일 때, 관리자 알림+고객 상담 채널 개설을
  /// 한 번만 보내기 위한 중복 방지 플래그
  dedicatedNodeAlertSent    Boolean     @default(false)
  /// 동시에 두 번(관리자/고객이 같은 주문에 대해 겹쳐서 /api/orders/[id]를 호출하는 등) 서버
  /// 생성이 시작되는 걸 막기 위한 원자적 "선점" 마커 — null이 아니면 이미 누군가 생성을 시작함
  provisioningStartedAt      DateTime?
  createdAt                 DateTime    @default(now())

  @@index([userId])
  @@index([status])
}

// ────────────────────────────────
// 코인(가상자산) 결제 — 은행 계좌이체와 나란한 두 번째 결제 수단.
// 고객이 "자기 서비스의 대가"로 코인을 받는 가맹점 결제이며, 타인의 자산을 보관·교환·이전해
// 주는 사업이 아니다(가상자산사업자 신고 대상 아님). 서버에는 개인키/시드구문을 절대 두지
// 않는다 — BTC/LTC/TRX(USDT-TRC20 포함)는 secp256k1 BIP32 확장공개키(xpub)만으로 입금
// 주소를 파생하는 감시 전용 지갑이고, SOL(ed25519는 공개키만으로 자식 주소를 못 만듦)은
// 운영자가 오프라인에서 미리 만들어둔 주소 목록(addressPool)을 하나씩 배정해 쓴다.
// ────────────────────────────────

enum CryptoCoin {
  /// TRON(TRC20) 위의 USDT — 가장 먼저 지원
  USDT_TRC20
  /// Solana(SPL) 위의 USDT
  USDT_SOL
  BTC
  LTC
  TRX
  SOL
}

enum CryptoPaymentStatus {
  /// 입금 대기 — 아직 아무 트랜잭션도 안 보임
  PENDING
  /// 트랜잭션은 감지했지만 확인(컨펌) 수가 아직 부족
  DETECTED
  /// 확인 진행 중(DETECTED와 사실상 같지만 UI 문구 구분용으로 남겨둠)
  CONFIRMING
  /// 들어온 금액이 주문 금액보다 적음 — 관리자 확인 필요
  UNDERPAID
  /// 필요한 확인 수를 채우고 금액도 충분함 — 결제 확정, markOrderPaidAndFulfill 호출 대상
  CONFIRMED
  /// expiresAt이 지날 때까지 입금이 없었음
  EXPIRED
  /// 검증 중 돌이킬 수 없는 문제(잘못된 토큰 컨트랙트 등)
  FAILED
  /// 자동 판단이 애매해서(초과입금, 만료 후 뒤늦은 입금 등) 관리자가 직접 승인/거절해야 함
  MANUAL_REVIEW
}

/// 코인별 지갑 설정(싱글턴 1행/코인) — 관리자가 /admin/crypto에서 xpub 또는 주소 목록을 입력한다.
/// enabled가 false거나 xpub/addressPool이 모두 비어있으면 결제 화면에서 그 코인은 숨긴다.
model CryptoWalletConfig {
  id                    String     @id @default(cuid())
  coin                  CryptoCoin @unique
  /// BTC/LTC/TRX/USDT_TRC20용 — 운영자가 오프라인에서 생성한 확장 "공개"키(xpub/ypub/zpub 등).
  /// 이 값만으로는 자금을 옮길 수 없고 입금 주소 파생/감시만 가능하다
  xpub                  String?
  /// SOL/USDT_SOL용 — [{ "address": "...", "used": false }] 형태로 운영자가 오프라인에서
  /// 만든 받기 전용 주소를 미리 등록해두고 주문마다 하나씩 배정한다
  addressPool           Json?      @default("[]")
  confirmationsRequired Int        @default(1)
  enabled               Boolean    @default(false)
  /// 다음에 파생할 BIP32 주소 인덱스 — 동시에 두 주문이 같은 주소를 받는 일이 없도록
  /// CryptoPayment 생성 트랜잭션 안에서 원자적으로 증가시킨다
  nextDerivationIndex   Int        @default(0)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model CryptoPayment {
  id               String              @id @default(cuid())
  orderId          String              @unique
  order            Order               @relation(fields: [orderId], references: [id])
  coin             CryptoCoin
  address          String
  /// xpub 파생 주소일 때만(BTC/LTC/TRX 계열) 채워짐 — SOL은 addressPool에서 골랐으니 null
  derivationIndex  Int?
  /// 환율은 주문 생성 시점에 고정한다 — 나중에 시세가 바뀌어도 이 주문은 이 환율 그대로
  exchangeRateKrw  Decimal
  amountCrypto     Decimal
  /// 지금까지 이 주소로 들어온 걸 합산한 금액 — 한 주문에 트랜잭션이 여러 번 나뉘어 들어와도 합산 처리
  receivedCrypto   Decimal             @default(0)
  confirmations    Int                 @default(0)
  status           CryptoPaymentStatus @default(PENDING)
  /// 이 주소로 감지된 모든 트랜잭션 — [{ "txHash": "...", "amount": "...", "confirmations": 0, "detectedAt": "..." }]
  /// 같은 txHash가 두 번 들어오지 않게(웹훅 위조·중복 폴링 등) 감시 로직이 항상 이 배열로 먼저 중복 확인한다
  transactions     Json                @default("[]")
  expiresAt        DateTime
  reviewedByUserId String?
  reviewNote       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status])
  @@index([coin, address])
}

// ────────────────────────────────
// 마인크래프트 서버
// ────────────────────────────────

enum ServerStatus {
  PROVISIONING
  RUNNING
  STOPPED
  STARTING
  STOPPING
  SUSPENDED
  ERROR
  DELETING
  /// 관리자가 다른 노드로 데이터를 이전하는 중 — 이 동안 콘솔/전원 조작 불가
  MIGRATING
}

enum ServerMemberRole {
  ADMIN
  MODERATOR
  DEVELOPER
  VIEWER
}

model Server {
  id         String         @id @default(cuid())
  ownerId    String
  owner      User           @relation(fields: [ownerId], references: [id])
  /// 상품이 삭제되면 null이 된다 — 서버 자체는 ramMb 등 스펙을 이미 자기 필드로 갖고 있어
  /// 계속 정상 동작한다. 상품 삭제는 언제나 가능해야 한다는 정책 때문에 필수 관계로 두지 않음
  productId  String?
  product    Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// 상품이 삭제돼도 결제내역/갱신가 계산에 쓸 수 있게 생성 시점 상품명·월정액을 스냅샷으로 남김
  productNameSnapshot   String?
  priceMonthlyKrwSnapshot Int?
  templateId String
  template   ServerTemplate @relation(fields: [templateId], references: [id])
  nodeId     String
  node       HostNode       @relation(fields: [nodeId], references: [id])

  name             String
  /// VPS/디스코드봇 등 마인크래프트가 아닌 서버는 null
  minecraftVersion String?
  /// 생성 시 실제로 쓰인 도커 이미지(런타임 버전 선택 등). null이면 template.dockerImage를 대신 쓴다 —
  /// 노드 이전(migration) 때 템플릿의 "현재" 기본값이 아니라 이 서버가 원래 쓰던 버전 그대로 재생성하기 위함
  dockerImage      String?
  status           ServerStatus @default(PROVISIONING)
  /// 대시보드 목록에서 상단 고정용
  isFavorite       Boolean      @default(false)
  /// 소유자만 보는 비공개 메모 (예: "친구 서버, 매달 15일 갱신")
  ownerNote        String?

  pterodactylServerId   Int?    @unique
  pterodactylUuid       String? @unique
  pterodactylIdentifier String?

  ramMb       Int
  cpuPercent  Int
  diskMb      Int
  backupSlots Int

  allocationIp   String?
  allocationPort Int?
  /// 기본 포트 외에 관리자가 추가로 할당해준 포트들. [{id(ptero allocation id), ip, port}]
  extraPorts Json @default("[]")
  /// 포인트 상점에서 EXTRA_SUBDOMAIN을 교환해 기본 제공(MAX_SUBDOMAINS_PER_SERVER)보다 더 늘린
  /// 서브도메인 슬롯 수 — 실제 서브도메인 생성은 이 슬롯이 있어야 기존 "주소 추가" 기능으로 가능
  extraSubdomainSlots Int @default(0)
  /// VPS(code-server) 등 egg가 자체 웹/접속 비밀번호를 요구할 때 서버마다 무작위로 생성해서 저장
  /// (전 서버 공통 기본값을 그대로 쓰면 남의 서버에 접속할 수 있는 보안 문제가 생김)
  accessSecret String?

  /// 서버당 최대 2개까지 (기본 1개 자동 생성 + 소유자가 1개 추가 가능)
  subdomains ServerSubdomain[]
  customDomains ServerCustomDomain[]
  resourceUpgradeGrants ResourceUpgradeGrant[]

  whitelistEnabled Boolean   @default(false)
  suspendedReason  String?
  renewalDueAt     DateTime?
  lastBackupAt     DateTime?

  /// 예약 백업/재시작 — 관리 크론(scripts/maintenance-cron.ts)이 주기적으로 확인해서 실행
  autoBackupEnabled       Boolean   @default(false)
  autoBackupIntervalHours Int       @default(24)
  autoRestartEnabled      Boolean   @default(false)
  /// KST 기준 0~23시. null이면 비활성
  autoRestartHour         Int?
  lastAutoRestartAt       DateTime?

  /// Git 자동 배포 — GIT_ADDRESS로 저장소를 연결한 서버에서 GitHub가 push 웹훅을 보내면
  /// git pull + 재시작을 자동으로 한다. 끄면 웹훅이 와도 무시한다.
  autoDeployEnabled   Boolean @default(false)
  /// GitHub 웹훅 서명(X-Hub-Signature-256) 검증용 비밀값. 자동 배포를 처음 켤 때 발급한다
  deployWebhookSecret String?
  /// git pull 뒤 재시작 전에 실행할 선택적 빌드 명령(예: npm install && npm run build).
  /// 비어있으면 pull만 하고 바로 재시작한다
  buildCommand        String?
  /// 특정 브랜치를 계속 추적하고 싶을 때(기본 브랜치가 아닌 다른 브랜치로 배포). null이면
  /// 저장소를 처음 설치했을 때 체크아웃된 브랜치(보통 기본 브랜치)를 그대로 쓴다
  gitBranch           String?
  /// 배포 결과(성공/실패)를 디스코드 DM 말고 외부로도 알리고 싶을 때 — Slack/Discord 둘 다
  /// 호환되는 웹훅 URL(Incoming Webhook)
  deployNotifyWebhookUrl String?

  /// HTTP로 서비스하는 서버(GENERAL/DISCORD_BOT)의 헬스체크 경로(예: "/health"). 설정하면
  /// 유지보수 크론이 주기적으로 핑을 보내고, 연속 실패 시 자동으로 재시작한다. null이면 비활성.
  healthCheckPath         String?
  /// 연속 실패 횟수 — 성공하면 0으로 리셋. 일정 횟수 넘으면 자동 재시작하고 다시 0으로 리셋
  healthCheckFailures     Int       @default(0)
  lastHealthCheckAt       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orders          Order[]
  backups         Backup[]
  members         ServerMember[]
  aiConversations AiConversation[]
  aiActivityLogs  AiActivityLog[]
  usageSnapshots  ServerUsageSnapshot[]
  activityLogs    ServerActivityLog[]
  scheduledTasks  ScheduledTask[]
  deploymentLogs  DeploymentLog[]

  @@index([ownerId])
  @@index([status])
}

/// 서버 콘솔에 주기적으로 명령을 보내는 간단한 "크론 작업". 분 단위 간격만 지원하고
/// (요일/시각 지정 없음), 실제 실행은 scripts/maintenance-cron.ts가 10분마다 돌면서 확인하기
/// 때문에 intervalMinutes가 10보다 작아도 최대 10분 지연될 수 있다.
model ScheduledTask {
  id              String    @id @default(cuid())
  serverId        String
  server          Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name            String
  /// 콘솔에 그대로 보낼 명령어
  command         String
  intervalMinutes Int
  enabled         Boolean   @default(true)
  lastRunAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([serverId])
}

enum DeployTrigger {
  MANUAL
  WEBHOOK
}

/// Git 배포(redeployFromGit) 1회 실행 기록 — GitDeployCard의 "배포 이력" 화면에서 보여준다.
/// Render/Railway의 deploy log 화면과 같은 개념
model DeploymentLog {
  id        String        @id @default(cuid())
  serverId  String
  server    Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  trigger   DeployTrigger
  /// 수동 배포를 누른 유저 — 웹훅 배포는 null
  actorUserId String?
  success   Boolean
  /// 콘솔에서 캡처한 git pull(+빌드 명령) 출력, 최대 2000자로 잘라서 저장
  output    String
  startedAt DateTime      @default(now())
  durationMs Int
  /// pull 직후 `git rev-parse HEAD`로 캡처한 커밋 해시 — 롤백 버튼에서 "이 시점으로 되돌리기"에 사용
  commitSha String?

  @@index([serverId, startedAt])
}

/// Render/Railway/Fly.io처럼 CLI·스크립트에서 자기 서버를 관리할 수 있게 해주는 개인 API 토큰.
/// 토큰 원문은 생성 시 한 번만 보여주고 저장하지 않는다 — DB에는 해시만 남긴다(비밀번호와 동일한 이유).
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// sha256(토큰 원문) — 원문은 생성 응답에만 담기고 어디에도 저장되지 않는다
  tokenHash  String    @unique
  /// 사용자가 토큰값을 알아볼 수 있게 보여주는 앞 8자 (burn_xxxxxxxx...)
  prefix     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// 로그인용 GitHub 연동(OAuthAccount)과는 별도 — 이건 "repo" 범위로 다시 동의받은, Git 배포
/// 기능에서 비공개 저장소까지 접근하기 위한 토큰이다. 로그인 흐름의 권한을 repo 범위까지
/// 넓히면 모든 로그인마다 과도한 권한을 요구하게 되므로 완전히 분리했다.
model GitHubConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubLogin String
  accessToken String
  connectedAt DateTime @default(now())
}

/// 10분마다 크론이 Wings에서 읽어오는 CPU/RAM/디스크 사용량 스냅샷 — 서버 상세 페이지의
/// 사용량 그래프에 쓰인다. 오래된 기록은 유지비용 대비 가치가 없어 30일 지나면 정리한다.
model ServerUsageSnapshot {
  id         String   @id @default(cuid())
  serverId   String
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  cpuPercent Float
  ramMb      Int
  diskMb     Int
  recordedAt DateTime @default(now())

  @@index([serverId, recordedAt])
}

/// 전원 조작·백업 복원·재설치·갱신·팀원 변경 등 서버에서 일어난 주요 사건을 시간순으로 남긴다.
/// 소유자/팀원이 "무슨 일이 있었는지" 바로 확인할 수 있게 하는 용도라 자잘한 파일 조작까지는 안 남긴다.
model ServerActivityLog {
  id        String   @id @default(cuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([serverId, createdAt])
}

model ServerMember {
  id        String           @id @default(cuid())
  serverId  String
  server    Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  role      ServerMemberRole @default(VIEWER)
  invitedAt DateTime         @default(now())

  @@unique([serverId, userId])
}

/// krl.kr 존의 서브도메인 하나 = A 레코드 + SRV(_minecraft._tcp) 레코드 한 쌍
model ServerSubdomain {
  id             String   @id @default(cuid())
  serverId       String
  server         Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  subdomain      String   @unique // 예: friends-smp -> friends-smp.krl.kr
  dnsARecordId   String?
  dnsSrvRecordId String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([serverId])
}

/// 고객이 자신의 외부 도메인을 서버에 연결(SRV/A 레코드는 고객이 직접 자기 DNS에 등록, 우리는 확인만)
enum CustomDomainSslStatus {
  NONE
  ISSUED
  FAILED
}

model ServerCustomDomain {
  id         String    @id @default(cuid())
  serverId   String
  server     Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  hostname   String    @unique
  verified   Boolean   @default(false)
  lastCheckedAt DateTime?
  createdAt  DateTime  @default(now())
  /// HTTP로 서비스하는 서버 종류(GENERAL/DISCORD_BOT)에서 연결한 도메인만 true — 이 경우에만
  /// 자동 SSL 발급 + 리버스 프록시 대상이 된다. 마인크래프트는 raw TCP라 TLS가 의미 없어서 제외.
  sslEligible      Boolean               @default(false)
  sslStatus        CustomDomainSslStatus @default(NONE)
  sslIssuedAt      DateTime?
  sslLastAttemptAt DateTime?
  sslError         String?

  @@index([serverId])
}

model Backup {
  id                  String    @id @default(cuid())
  serverId            String
  server              Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  pterodactylBackupId String?   @unique
  name                String
  sizeBytes           BigInt    @default(0)
  isAutomatic         Boolean   @default(false)
  status              String    @default("PENDING") // PENDING, COMPLETED, FAILED
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  @@index([serverId])
}

// ────────────────────────────────
// 이벤트 / 쿠폰 (관리자 프로모션)
// ────────────────────────────────

enum CouponDiscountType {
  PERCENT
  FIXED_KRW
}

model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  discountType  CouponDiscountType
  discountValue Int
  maxUses       Int?
  usedCount     Int                @default(0)
  minOrderKrw   Int                @default(0)
  active        Boolean            @default(true)
  startsAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())

  orders      Order[]
  event       Event?
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
}

model Event {
  id             String   @id @default(cuid())
  title          String
  description    String
  bannerImageUrl String?
  couponId       String?  @unique
  coupon         Coupon?  @relation(fields: [couponId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum AnnouncementLevel {
  INFO
  WARNING
  CRITICAL
}

/// 관리자가 사이트 전체(랜딩+대시보드)에 띄우는 공지 배너 — 점검 안내, 장애 안내 등
model Announcement {
  id        String            @id @default(cuid())
  title     String
  body      String
  level     AnnouncementLevel @default(INFO)
  active    Boolean           @default(true)
  /// 설정 시 이 기간 안에만 노출. 둘 다 비우면 active인 동안 계속 노출
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([active])
}

// ────────────────────────────────
// 서버 홍보 → 포인트 → 무료 서버 교환
// ────────────────────────────────

enum PromotionVerifyMethod {
  /// 유저가 제출한 URL을 서버가 직접 열어서 requiredText 포함 여부를 확인 (블로그/영상 설명란/게시글 등)
  URL_CONTAINS_LINK
  /// 유저 소유 서버의 server.properties motd에 문구가 포함돼 있는지 Pterodactyl로 직접 확인
  SERVER_MOTD_BRANDED
  /// 공식 디스코드 서버 가입 여부를 봇으로 확인
  DISCORD_MEMBER
  /// 내 추천 코드로 신규 가입 — 가입 완료 시 자동 지급
  REFERRAL_SIGNUP
  /// 추천으로 가입한 친구가 첫 유료 서버를 만들었을 때 자동 지급
  REFERRAL_FIRST_PAYMENT
  /// 자동 확인이 불가능해 관리자가 직접 승인해야 하는 방식
  MANUAL_REVIEW
  /// 유저가 만든 커뮤니티 프리셋(Egg 설정값)을 공개 등록했을 때 자동 지급
  CUSTOM_PRESET_PUBLISHED
}

/// 관리자가 관리하는 홍보 방법 카탈로그. 완료 시 promotionPoints 지급
model PromotionTask {
  id            String                @id @default(cuid())
  key           String                @unique
  title         String
  description   String
  pointsAwarded Int
  verifyMethod  PromotionVerifyMethod
  /// URL_CONTAINS_LINK 검증 시 페이지 내용에 포함돼야 하는 문구
  requiredText  String?               @default("burnae.kr")
  /// 여러 번 완료해서 포인트를 반복 적립할 수 있는지 (예: 추천 가입은 반복 가능)
  repeatable    Boolean               @default(false)
  active        Boolean               @default(true)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  completions PromotionCompletion[]

  @@index([active])
}

/// APPROVED: 포인트 즉시 지급됨. PENDING_REVIEW: MANUAL_REVIEW 방식 제출 후 관리자 승인 대기(포인트 미지급).
/// REJECTED: 관리자가 반려(포인트 미지급).
enum PromotionCompletionStatus {
  APPROVED
  PENDING_REVIEW
  REJECTED
}

model PromotionCompletion {
  id            String                     @id @default(cuid())
  userId        String
  user          User                       @relation(fields: [userId], references: [id])
  taskId        String
  task          PromotionTask              @relation(fields: [taskId], references: [id])
  /// 추천 관련 완료 건에서 "대상이 된 다른 유저"(추천받은 친구) — 같은 친구로 중복 지급되는 것을 막는 용도
  relatedUserId String?
  proofUrl      String?
  pointsAwarded Int
  status        PromotionCompletionStatus  @default(APPROVED)
  createdAt     DateTime                   @default(now())

  @@unique([taskId, userId, relatedUserId])
  @@index([userId])
  @@index([status])
}

// ────────────────────────────────
// 포인트 상점 (홍보 포인트로 교환하는 아이템 카탈로그)
// ────────────────────────────────

enum ShopItemKind {
  /// 즉시 aiCreditsRemaining 증가
  AI_CREDITS
  /// 다음 결제에 쓸 수 있는 쿠폰 발급 (Coupon 생성)
  DISCOUNT_COUPON
  /// 관리자가 수동으로 처리하는 기타 교환(예: 커스텀 도메인 지원 등) — 관리자 알림만 남김
  CUSTOM
  /// 아래 4개는 계정이 아니라 특정 서버를 대상으로 교환한다 (POST /api/servers/[id]/free-upgrade).
  /// amount 단위: RAM_UPGRADE=MB, CPU_UPGRADE=%, DISK_UPGRADE=MB, BACKUP_SLOT_UPGRADE=슬롯 개수.
  /// RAM/CPU/DISK 세 종류는 ResourceUpgradeGrant로 30일 시한부 적용되고 안 갱신하면 자동으로
  /// 줄어든다 — BACKUP_SLOT_UPGRADE만 예외로 영구 적용
  RAM_UPGRADE
  CPU_UPGRADE
  DISK_UPGRADE
  BACKUP_SLOT_UPGRADE
  /// 계정 단위 — durationDays 동안만 무료 서버를 1개 더 만들 수 있게 해준다 (ExtraFreeSlotGrant 생성)
  EXTRA_FREE_SLOT
  /// 아래 2개도 특정 서버를 대상으로 교환한다 (POST /api/servers/[id]/extra-resources) — 무료/유료
  /// 서버 모두 가능(위 4개의 free-upgrade와 달리 플랜 제한 없음). RAM/CPU/DISK처럼 시한부지만
  /// 기간이 다름 — EXTRA_RESOURCE_RENEWAL_DAYS(120일)마다 갱신 필요, 안 갱신하면 크론이 회수.
  /// amount=1 고정, maxTotal로 서버당 최대 "추가" 개수 제한(EXTRA_PORT는 server.extraPorts.length,
  /// EXTRA_SUBDOMAIN은 server.extraSubdomainSlots 기준 — 기본 제공분과는 별도로 센다)
  EXTRA_PORT
  EXTRA_SUBDOMAIN
}

model ShopItem {
  id          String       @id @default(cuid())
  name        String
  description String?
  kind        ShopItemKind
  pointsCost  Int
  /// AI_CREDITS: 지급할 크레딧 수. DISCOUNT_COUPON: 할인율(%). *_UPGRADE: 한 번에 늘어나는 양
  amount      Int?
  /// *_UPGRADE 전용 — 서버당 이 항목의 총 누적치가 넘으면 더 이상 교환 못 함(무한 증설 방지)
  maxTotal    Int?
  /// EXTRA_FREE_SLOT 전용 — 며칠 동안 유효한지. 다른 kind는 null(영구 적용)
  durationDays Int?
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  redemptions ShopRedemption[]
  resourceUpgradeGrants ResourceUpgradeGrant[]

  @@index([active])
}

/// RAM/CPU/DISK_UPGRADE 교환 1건마다 생기는 시한부 증설 기록. expiresAt이 지나면 크론이
/// amount만큼 서버 자원을 원래대로 되돌린다(단, 그 사이 유료 플랜으로 전환됐다면 되돌리지 않고
/// 그냥 소멸시킨다). 이용자는 만료 전 대시보드에서 "갱신"을 눌러 expiresAt을 30일 뒤로 다시 미룰 수 있다.
model ResourceUpgradeGrant {
  id        String       @id @default(cuid())
  serverId  String
  server    Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  itemId    String?
  item      ShopItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  kind      ShopItemKind
  amount    Int
  expiresAt DateTime
  createdAt DateTime     @default(now())
  /// EXTRA_PORT 전용 — 만료 시 정확히 이 allocation을 해제하기 위한 정보. {id, ip, port}
  metadata  Json?

  @@index([serverId])
  @@index([expiresAt])
}

model ShopRedemption {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  itemId     String
  item       ShopItem @relation(fields: [itemId], references: [id])
  pointsSpent Int
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// 포인트 상점의 EXTRA_FREE_SLOT 교환으로 생기는 임시 무료 서버 슬롯. expiresAt이 지나면
/// 더 이상 세지 않는다(별도 크론 없이 조회 시점에 expiresAt만 확인하면 됨).
model ExtraFreeSlotGrant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ────────────────────────────────
// 결제 계좌 표시 정보 (관리자 설정)
// ────────────────────────────────

model BankAccountSetting {
  id            String   @id @default(cuid())
  bankName      String
  accountNumber String
  accountHolder String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// 하나은행 거래내역조회 폴링 커서 (싱글턴). client_credentials 방식이라 별도 토큰 저장은
/// 필요 없고, 크론이 "마지막으로 어디까지 확인했는지"만 여기 기록해둔다.
model HanaBankSync {
  id            Int      @id @default(1)
  lastCheckedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ────────────────────────────────
// AI 챗봇
// ────────────────────────────────

enum AiMessageRole {
  USER
  ASSISTANT
  TOOL
}

/// CHAT = "AI" 탭(서버 관리/운영 상담), MAKER = "메이커" 탭(플러그인/봇/웹사이트 등을 대화로 만들고 업그레이드)
/// — 둘 다 같은 엔진(runAiTurn)을 쓰지만 대화 목록이 섞이지 않게 구분한다
enum AiConversationKind {
  CHAT
  MAKER
}

model AiConversation {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  serverId  String?
  server    Server?            @relation(fields: [serverId], references: [id])
  kind      AiConversationKind @default(CHAT)
  title     String             @default("새 대화")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  messages AiMessage[]

  @@index([userId])
  @@index([serverId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  content        String
  toolCalls      Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

enum AiRiskLevel {
  SAFE
  CONFIRM
  DANGEROUS
}

enum AiActionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

model AiActivityLog {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  serverId       String
  server         Server         @relation(fields: [serverId], references: [id])
  conversationId String?
  /// 모델이 발급한 tool_use 블록 id — 승인 후 대화를 이어가기 위해 필요
  toolUseId      String?
  toolName       String
  riskLevel      AiRiskLevel
  status         AiActionStatus @default(PENDING_APPROVAL)
  input          Json
  result         Json?
  /// 위험 작업 실행 전 자동 백업한 스냅샷 id (되돌리기용)
  backupId       String?
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?

  @@index([userId])
  @@index([serverId])
  @@index([conversationId])
}

// ────────────────────────────────
// 고객지원(웹 대시보드 1:1 문의)
// ────────────────────────────────

enum SupportThreadStatus {
  OPEN
  CLOSED
}

enum SupportSenderRole {
  USER
  ADMIN
}

/// 유저 1명당 여러 건 가능하지만, 보통 OPEN은 최대 1개만 유지한다(새 문의는 열려있는 걸 이어씀)
model SupportThread {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    SupportThreadStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  messages  SupportMessage[]

  @@index([userId])
  @@index([status])
}

model SupportMessage {
  id         String            @id @default(cuid())
  threadId   String
  thread     SupportThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderRole SupportSenderRole
  content    String
  createdAt  DateTime          @default(now())

  @@index([threadId])
}

// ────────────────────────────────
// 디스코드 봇 연동
// ────────────────────────────────

model DiscordLink {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  discordUserId String   @unique
  linkedAt      DateTime @default(now())
}

/// 웹 대시보드에서 발급하고 디스코드 봇에서 /link 로 입력하는 1회용 연동 코드
model DiscordLinkCode {
  id        String   @id @default(cuid())
  userId    String
  code      String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// 디스코드 봇 관련 설정(싱글턴) — 관리자 패널(/admin/discord)에서 수정.
/// 역할/채널 ID는 봇 프로세스가 REST/게이트웨이 양쪽에서 공통으로 참조한다.
model BotSettings {
  id                    Int      @id @default(1)
  /// 규칙 인증 버튼을 눌렀을 때 부여할 역할
  verifiedRoleId        String?
  /// 결제(또는 포인트 교환)로 서버를 만들면 자동으로 부여할 역할
  purchaserRoleId       String?
  /// "공지 알림 받기" 버튼으로 스스로 토글하는 역할
  subscriberRoleId      String?
  /// Burnae 관리자 권한(adminRole)이 생기면 자동으로 부여하고, 없어지면 자동으로 회수하는 역할
  adminRoleId           String?
  rulesTitle            String   @default("📜 서버 규칙")
  rulesContent          String   @default("")
  /// 규칙+인증 임베드가 올라갈 채널. 저장 시 이 채널에 없으면 새로 올리고, 있으면 있는 메시지를 수정한다
  rulesChannelId        String?
  rulesMessageId        String?
  linktreeTitle         String   @default("🔗 Burnae 링크")
  linktreeChannelId     String?
  linktreeMessageId     String?
  /// 실시간 집계 현황판이 올라갈 채널 — 개별 고객 서버 정보는 노출하지 않고 전체 통계만 보여준다
  statusBoardChannelId  String?
  statusBoardMessageId  String?
  /// 노드별 RAM/CPU/저장공간 점유율 현황판(관리자용)이 올라갈 채널
  nodeStatusChannelId   String?
  nodeStatusMessageId   String?
  /// 관리자가 공지를 등록하면 자동으로 임베드를 올릴 채널
  announcementChannelId String?
  /// 서버 생성/삭제/이전 같은 이벤트를 기록으로 남길 채널
  logChannelId          String?
  updatedAt             DateTime @updatedAt

  @@map("bot_settings")
}

/// 관리자가 편집하는 링크트리 항목 — /링크트리 명령어와 채널 임베드에 그대로 반영
model LinktreeLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  emoji     String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

/// 디스코드 /설문 명령어로 받은 자유 응답 — 관리자 패널에서 확인
model SurveyResponse {
  id            String   @id @default(cuid())
  discordUserId String?
  discordTag    String?
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  content       String
  reviewed      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([reviewed])
}

/// 관리자가 만들어서 디스코드 채널에 올리는 투표형 설문 — 버튼으로 누구나 답할 수 있다
model Survey {
  id        String       @id @default(cuid())
  question  String
  options   String[]
  channelId String
  messageId String?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  votes SurveyVote[]
}

model SurveyVote {
  id            String   @id @default(cuid())
  surveyId      String
  survey        Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  discordUserId String
  optionIndex   Int
  createdAt     DateTime @default(now())

  @@unique([surveyId, discordUserId])
}

// ────────────────────────────────
// 감사 로그
// ────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
}

// ────────────────────────────────
// 블로그
// ────────────────────────────────

/// 국내 호스팅사 가격 비교 같은 콘텐츠 마케팅용 블로그. titleEn/bodyEn이 비어 있으면 영어
/// 페이지에서는 "한국어로만 제공돼요" 안내만 보여준다(legal 페이지와 같은 패턴) — 국내
/// 호스팅사 비교처럼 애초에 한국 시장 한정인 글을 억지로 기계번역해서 보여주지 않기 위함.
model BlogPost {
  id           String    @id @default(cuid())
  slug         String    @unique
  titleKr      String
  excerptKr    String?
  /// 마크다운 원문
  bodyKr       String
  titleEn      String?
  excerptEn    String?
  bodyEn       String?
  published    Boolean   @default(false)
  publishedAt  DateTime?
  authorUserId String?
  author       User?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([published, publishedAt])
}
